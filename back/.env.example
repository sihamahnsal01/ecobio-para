# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/ecobio-para
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecobio-para
MONGO_URI=mongodb://127.0.0.1:27017/ecobio-para

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Your deployed frontend origin, for CORS. Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Admin button target for opening the customer product storefront.
VITE_STOREFRONT_URL=http://localhost:5173/products
VITE_STOREFRONT_ORIGIN=http://localhost:5173

# SMTP settings used to email newsletter subscribers when an admin creates a promotion.
# For Gmail, use an App Password and set SMTP_SECURE=false for port 587.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=Eco&Bio <your-email@example.com>

# Stripe hosted Checkout. Never put this secret in the frontend.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: customize the admin account created by `npm run seed`.
# If omitted, these defaults are used.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@ecobio-para.ma
SEED_ADMIN_PASSWORD=admin123
